# MediScan Production Cloud Configuration Environment Variables

SECRET_KEY=mediscan-secret-key-production-2026-change-this
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# =========================================================
# CLOUD DATABASE CONFIGURATION (Supabase / Neon / AWS RDS / Cloud SQL)
# =========================================================
# Set DATABASE_URL to your Cloud DB Connection String:
# Example Supabase / Postgres: postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres
# Example MySQL Cloud SQL: mysql+pymysql://root:password@10.0.0.1:3306/mediscan_db
DATABASE_URL=sqlite:///mediscan.db

# Option 2: MySQL Direct Configuration
USE_MYSQL=False
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=mediscan_db

# =========================================================
# CLOUD OBJECT STORAGE CONFIGURATION (AWS S3 / Supabase Storage)
# =========================================================
CLOUD_STORAGE_ENABLED=True
CLOUD_PROVIDER=AWS_S3_ENCRYPTED
CLOUD_BUCKET_NAME=mediscan-secure-medical-vault
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Local Storage Folders
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432

# AI Framework Settings
USE_GPU=False
MODEL_VERSION=v1.2.0-resnet50-fusion
